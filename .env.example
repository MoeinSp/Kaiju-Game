# ── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=
OWNER_TELEGRAM_ID=
# The "open the full panel" button inside the bot links here. On a VPS put your
# real domain: https://panel.example.com/panel/
ADMIN_PANEL_URL=http://127.0.0.1:8000/panel/

# ── Django ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=true
# Comma-separated. Narrow this to your real domain in production.
DJANGO_ALLOWED_HOSTS=*
# Required for panel form submits over https — must include the scheme:
#   https://panel.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set both to true when a reverse proxy terminates TLS in front of the panel.
DJANGO_BEHIND_PROXY=false
DJANGO_SECURE_COOKIES=false

# ── Database ────────────────────────────────────────────────────────────────
# Leave POSTGRES_DB empty for local dev and the app uses the SQLite file below.
# Setting it switches the whole app (bot + panel) to Postgres — docker-compose
# sets it for you.
POSTGRES_DB=
POSTGRES_USER=kaiju
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# SQLite path, used only when POSTGRES_DB is empty.
DJANGO_DB_PATH=

# ── Panel / backups ─────────────────────────────────────────────────────────
# Where the panel writes backup archives. In Docker this is a named volume.
BACKUP_DIR=
# Host binding for docker-compose. 127.0.0.1 keeps the panel private; put nginx
# or caddy in front and only change this if you know you want it exposed.
PANEL_BIND=127.0.0.1
PANEL_PORT=8000

# Game clock. The day boundary for daily missions, login streaks and weekly
# season resets is midnight in THIS timezone (not UTC).
GAME_TIMEZONE=Asia/Tehran

# Bot's @username without the @ — used for the group cards' "open in DM" buttons.
BOT_USERNAME=HeroGameZbot
